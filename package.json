{
  "name": "better-email",
  "version": "1.0.53",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "build:verify": "npm run build && npm run check:architecture && npm run check:css && npm run check:performance",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:css": "node scripts/check-css-graph.mjs",
    "check:performance": "node scripts/check-performance-budget.mjs",
    "bench": "node scripts/benchmark.mjs",
    "bench:release": "tauri build --no-bundle && npm run bench",
    "bench:app": "tauri build --no-bundle && node scripts/benchmark.mjs --sample-app",
    "bench:sync": "tauri build --no-bundle && node scripts/benchmark.mjs --sample-app --sample-sync",
    "probe:provider": "cargo run --manifest-path src-tauri/Cargo.toml --example provider_probe --",
    "test:services": "node scripts/test-services.mjs",
    "test:ui": "node scripts/run-ui-smoke.mjs",
    "tauri:dev": "node scripts/tauri-dev.mjs",
    "tauri:build": "tauri build",
    "tauri": "tauri",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-react": "^0.577.0",
    "pinyin-pro": "3.29.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
