{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Better Email",
  "version": "1.0.47",
  "identifier": "app.betteremail.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:17420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "Better Email",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#f7f8f7",
        "visible": false,
        "focus": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        },
        "hiddenTitle": true
      },
      {
        "label": "splashscreen",
        "create": false,
        "url": "splashscreen.html",
        "title": "Better Email",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#f7f8f7",
        "visible": false,
        "focus": true,
        "focusable": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        },
        "hiddenTitle": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost https:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/attachments/**",
          "$APPDATA/temp_attachments/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0MjdCMzM3QTQwMDY0QgpSV1JMQmtCNk0zdENBMmNNb3NpV2pLeGF3LzFzSzJkQUtpT3l4QUhXSU43UmM4L2x1U1dyZERCYwo=",
      "endpoints": [
        "https://github.com/anYuJia/better-email/releases/latest/download/latest.json"
      ]
    }
  }
}
